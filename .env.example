# Never commit a populated .env file. Copy this file to .env and fill your own credentials.
# Required for qwen3.7-text-embedding and the optional DashScope fallback model.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
# Required when CHAT_PROVIDER=deepseek (the default below).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Optional. Enable MinerU only when you are authorized to upload the source PDF.
MINERU_API_TOKEN=
CHAT_PROVIDER=deepseek
CHAT_MODEL=deepseek-v4-flash-vision-exp
EMBEDDING_MODEL=qwen3.7-text-embedding
MINERU_MODEL=pipeline
MINERU_LANGUAGE=en
MINERU_ENABLED=false
MULTIMODAL_ENABLED=true
PAGE_IMAGE_DPI=120
PAGE_IMAGE_JPEG_QUALITY=85
MAX_VISUAL_PAGES=3
PROJECT_DATA_DIR=./data
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_CANDIDATE_K=8
RETRIEVAL_CONTEXT_K=6
SUMMARY_BATCH_CHUNKS=40
MODEL_TIMEOUT_SECONDS=15
MODEL_MAX_OUTPUT_TOKENS=1200
DISABLE_MODEL_THINKING=true
FALLBACK_CHAT_MODEL=qwen-plus
FALLBACK_CHAT_PROVIDER=dashscope
FALLBACK_MODEL_TIMEOUT_SECONDS=45
MODEL_CIRCUIT_BREAKER_SECONDS=300
LOG_LEVEL=INFO
